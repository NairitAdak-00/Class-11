word = str(input("Enter a number below 4000"))
num = int(word)
pow = 10**(len(word)-1)
size = len(word)
roman = ""
if size==4:
   for i in range(num//pow):
       roman = roman+"M"
   num=num%pow
   pow = pow//10
   size = size-1
if size==3:
   if num//pow>=5:
      roman = roman+"D"
      num = num-500
   if num//pow==4:
       roman=roman+"CD"
   else:
      for i in range(num//pow):
         roman = roman+"C"
   num=num%pow
   pow = pow//10
   size = size-1
if size==2:
   if num//pow>=5:
      roman = roman+"L"
      num = num-50
   if num//pow==4:
       roman=roman+"XL"
   else:
      for i in range(num//pow):
         roman = roman+"X"
   num=num%pow
   pow = pow//10
   size = size-1
if size==1:
   if num//pow>=5:
      roman = roman+"V"
      num = num-5
   if num//pow==4:
       roman=roman+"IV"
   else:      
      for i in range(num//pow):
         roman = roman+"I"
print(roman)
